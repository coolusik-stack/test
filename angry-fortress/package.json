{
  "name": "dotori-fortress",
  "version": "0.1.0",
  "private": true,
  "description": "도토리깡 — squirrel slingshot duel (web + iOS via Capacitor)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "ios": "node scripts/build-www.mjs && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
